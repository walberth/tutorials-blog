# =============================================================================
# .env.example  —  Variables de entorno de la demo SQL Server + Kafka + Debezium
# -----------------------------------------------------------------------------
# CÓMO USARLO:
#   1. Copia este archivo a ".env"        ->  cp .env.example .env   (o copy en Windows)
#   2. Ajusta los valores si lo necesitas (sobre todo la contraseña de SQL Server).
#   3. docker compose lee ".env" AUTOMÁTICAMENTE al ejecutarse.
#
# NOTA: ".env" NO debe subirse a git (ya está en .gitignore). Este ".env.example"
#       SÍ se versiona, para que cualquiera sepa qué variables existen.
# =============================================================================

# -----------------------------------------------------------------------------
# SQL Server
# -----------------------------------------------------------------------------
# Contraseña del usuario 'sa'. DEBE cumplir la política de complejidad de SQL Server:
#   mínimo 8 caracteres, con mayúsculas, minúsculas, números y símbolos.
# Si la cambias aquí, recuerda que el connector de Debezium la usa también
# (connect/sqlserver-source-connector.json) — mantenlas sincronizadas.
MSSQL_SA_PASSWORD=Passw0rd!Strong

# Edición del motor. "Developer" es gratuita, tiene todas las features (incluido CDC)
# y NO es válida para producción — perfecta para una demo.
MSSQL_PID=Developer

# Puerto que se expone en tu máquina (host) para conectarte con SSMS/Azure Data Studio.
MSSQL_HOST_PORT=1433

# Nombre de la base de datos de la demo. Debe coincidir con "database.names" del connector.
DEMO_DATABASE=DemoCDC

# -----------------------------------------------------------------------------
# Kafka (modo KRaft, sin Zookeeper)
# -----------------------------------------------------------------------------
# Puerto expuesto en el host para clientes externos (por si quieres usar kafka-console-*).
KAFKA_HOST_PORT=9092

# ID de cluster para KRaft. Es un valor fijo (base64) para que el formateo sea reproducible.
# Puedes generar otro con: docker run --rm confluentinc/cp-kafka:7.6.1 kafka-storage random-uuid
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk

# -----------------------------------------------------------------------------
# Kafka Connect (Debezium)
# -----------------------------------------------------------------------------
# Puerto de la API REST de Kafka Connect (para registrar/consultar connectors).
CONNECT_HOST_PORT=8083

# -----------------------------------------------------------------------------
# Kafka UI
# -----------------------------------------------------------------------------
# Puerto donde abrirás la interfaz web: http://localhost:8080
KAFKA_UI_HOST_PORT=8080

# -----------------------------------------------------------------------------
# Web Viewer (streaming en vivo de eventos CDC)
# -----------------------------------------------------------------------------
# Puerto donde abrirás el visor en vivo: http://localhost:3000
WEB_VIEWER_HOST_PORT=3000